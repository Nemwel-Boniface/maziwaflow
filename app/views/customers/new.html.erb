<div class="max-w-2xl mx-auto py-8 px-4">
  <div class="mb-6">
    <%= link_to "← Back to Customers", customers_path, class: "text-sm font-medium text-green-600 hover:text-green-800" %>
  </div>

  <div class="bg-white shadow-sm border border-slate-200 rounded-2xl overflow-hidden">
    <div class="px-6 py-4 border-b border-slate-200 bg-green-600">
      <h2 class="text-xl font-bold text-white">Register New Customer</h2>
    </div>

    <%# data: { turbo: false } ensures the button works even if Turbo JS is failing %>
    <%= form_with(model: @customer, url: customers_path, data: { turbo: false }, class: "p-6 space-y-5") do |f| %>
      <% if @customer.errors.any? %>
        <div class="p-4 bg-red-50 border border-red-200 rounded-lg text-red-700 text-sm">
          <p class="font-bold"><%= pluralize(@customer.errors.count, "error") %> prevented this save:</p>
          <ul class="list-disc list-inside">
            <% @customer.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= f.label :name, class: "block text-sm font-semibold text-slate-700 mb-1" %>
        <%= f.text_field :name, autofocus: true, placeholder: "e.g. John Doe", required: true, class: "block w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-green-500 focus:border-green-500 sm:text-sm" %>
      </div>

      <div>
        <%= f.label :phone_number, class: "block text-sm font-semibold text-slate-700 mb-1" %>
        <%= f.telephone_field :phone_number, placeholder: "0712 345 678", class: "block w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-green-500 focus:border-green-500 sm:text-sm" %>
      </div>

      <div class="pt-4">
        <%= f.submit "Save Customer", class: "w-full flex justify-center py-3 px-4 border border-transparent rounded-lg shadow-sm text-sm font-bold text-white bg-green-600 hover:bg-green-700 cursor-pointer transition-all active:scale-95" %>
      </div>
    <% end %>
  </div>
</div>