<div class="py-6 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  <div class="sm:flex sm:items-center sm:justify-between mb-8">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Customers</h1>
      <p class="mt-2 text-sm text-slate-600">A list of all clients and their current balances.</p>
    </div>
    <div class="mt-4 sm:mt-0">
      <%= link_to "Add New Customer", new_customer_path, class: "inline-flex items-center px-4 py-2 border border-transparent rounded-lg shadow-sm text-sm font-bold text-white bg-green-600 hover:bg-green-700 transition-colors" %>
    </div>
  </div>

  <div class="bg-white shadow border border-slate-200 rounded-2xl overflow-hidden">
    <div class="px-4 py-4 border-b border-slate-200 bg-slate-50">
      <%= form_with url: customers_path, method: :get, local: true, class: "grid grid-cols-1 md:grid-cols-12 gap-3 items-end" do %>
        <div class="md:col-span-6">
          <label for="query" class="block text-xs font-semibold text-slate-600 mb-1">Search name or phone</label>
          <%= text_field_tag :query, @query, list: "customer-name-options", placeholder: "Type customer name or phone", class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500" %>
          <datalist id="customer-name-options">
            <% @customer_name_suggestions.each do |name| %>
              <option value="<%= name %>"></option>
            <% end %>
          </datalist>
        </div>

        <div class="md:col-span-3">
          <label for="status" class="block text-xs font-semibold text-slate-600 mb-1">Status</label>
          <%= select_tag :status, options_for_select([["All", ""], ["Active", "active"], ["Inactive", "inactive"]], @status_filter), class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500" %>
        </div>

        <div class="md:col-span-2">
          <label class="inline-flex items-center gap-2 text-sm text-slate-700 py-2">
            <%= check_box_tag :owes_only, "1", @owes_only, class: "rounded border-slate-300 text-green-600 focus:ring-green-500" %>
            Owes us only
          </label>
        </div>

        <div class="md:col-span-1 flex md:justify-end gap-2">
          <%= button_tag "Filter", type: "submit", class: "inline-flex items-center px-4 py-2 rounded-lg text-sm font-semibold text-white bg-green-600 hover:bg-green-700 transition-colors" %>
          <%= link_to "Clear", customers_path, class: "inline-flex items-center px-3 py-2 rounded-lg text-sm font-semibold text-slate-600 bg-white border border-slate-300 hover:bg-slate-50 transition-colors" %>
        </div>
      <% end %>
    </div>

    <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-slate-200">
      <thead class="bg-slate-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Status</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Name</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Phone</th>
          <th class="px-6 py-3 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider">Balance (KES)</th>
          <th class="px-6 py-3 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-slate-100">
        <% @customers.each do |customer| %>
          <tr class="hover:bg-slate-50 transition-colors">
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= customer.active ? 'bg-green-100 text-green-800' : 'bg-slate-100 text-slate-400' %>">
                <%= customer.active ? 'Active' : 'Inactive' %>
              </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-green-600 hover:underline">
              <%= link_to customer.name, customer_path(customer) %> 
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-500"><%= customer.phone_number.presence || "-" %></td>
            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-bold <%= customer.balance > 0 ? 'text-red-600' : 'text-emerald-600' %>">
              <%= number_to_currency(customer.balance, unit: "KES ") %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-right text-sm">
              <% if customer.active && customer.balance > 0 %>
                <span class="text-slate-300 cursor-not-allowed" title="Cannot deactivate: Balance must be 0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 inline" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                  </svg>
                </span>
              <% else %>
                <%= button_to toggle_active_customer_path(customer), method: :patch, class: "text-slate-400 hover:text-green-600 transition-colors" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
                  </svg>
                <% end %>
              <% end %>
            </td>
          </tr>
        <% end %>
        <% if @customers.none? %>
          <tr>
            <td colspan="5" class="px-6 py-10 text-center text-sm text-slate-500">No customers found.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
    </div>
    <%# Pagination Call %>
    <%= render 'shared/pagination', total_pages: @total_pages, current_page: @page, param_name: :page %>
  </div>
</div>