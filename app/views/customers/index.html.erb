<div class="py-6 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  <div class="sm:flex sm:items-center sm:justify-between mb-8">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Customers</h1>
      <p class="mt-2 text-sm text-slate-600">A list of all clients and their current balances.</p>
    </div>
    <div class="mt-4 sm:mt-0">
      <%= link_to "Add New Customer", new_customer_path, class: "inline-flex items-center px-4 py-2 border border-transparent rounded-lg shadow-sm text-sm font-bold text-white bg-blue-600 hover:bg-blue-700 transition-colors" %>
    </div>
  </div>

  <div class="bg-white shadow border border-slate-200 rounded-2xl overflow-hidden">
    <table class="min-w-full divide-y divide-slate-200">
      <thead class="bg-slate-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Name</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Phone</th>
          <th class="px-6 py-3 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider">Balance (KES)</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-slate-100">
        <% @customers.each do |customer| %>
          <tr class="hover:bg-slate-50 transition-colors">
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-slate-900"><%= customer.name %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-500"><%= customer.phone_number.presence || "-" %></td>
            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-bold <%= customer.balance > 0 ? 'text-red-600' : 'text-emerald-600' %>">
              <%= number_to_currency(customer.balance, unit: "KES ") %>
            </td>
          </tr>
        <% end %>
        <% if @customers.none? %>
          <tr>
            <td colspan="3" class="px-6 py-10 text-center text-sm text-slate-500">No customers found.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>