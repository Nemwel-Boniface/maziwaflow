<div class="py-6">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8">
    <h1 class="text-2xl font-semibold text-slate-900">Milk Shop Overview</h1>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8 mt-8">
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-3">
      <div class="bg-white overflow-hidden shadow rounded-2xl border border-slate-200 p-6">
        <dt class="text-sm font-medium text-slate-500 truncate">Total Customers</dt>
        <dd class="mt-1 text-3xl font-bold text-blue-600"><%= @total_customers %></dd>
      </div>

      <div class="bg-white overflow-hidden shadow rounded-2xl border border-slate-200 p-6">
        <dt class="text-sm font-medium text-slate-500 truncate">Liters Sold (Today)</dt>
        <dd class="mt-1 text-3xl font-bold text-slate-900"><%= @total_liters_today %> L</dd>
      </div>

      <div class="bg-white overflow-hidden shadow rounded-2xl border border-slate-200 p-6 border-l-4 border-l-red-500">
        <dt class="text-sm font-medium text-slate-500 truncate">Total Unpaid (KES)</dt>
        <dd class="mt-1 text-3xl font-bold text-red-600">KES <%= number_with_delimiter(@outstanding_debt) %></dd>
      </div>
    </div>

    <div class="mt-10">
      <h2 class="text-lg font-medium text-slate-900 mb-4">Quick Actions</h2>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <%= link_to sales_path, class: "flex items-center p-4 bg-white border border-slate-200 rounded-xl hover:bg-blue-50 transition-colors group" do %>
            <span class="p-3 bg-blue-100 rounded-lg text-blue-600 mr-4 group-hover:bg-blue-600 group-hover:text-white transition-colors">
            ➕
            </span>
            <span class="font-bold text-slate-700">View Sales</span>
        <% end %>
        
        <%= link_to customers_path, class: "flex items-center p-4 bg-white border border-slate-200 rounded-xl hover:bg-green-50 transition-colors group" do %>
            <span class="p-3 bg-green-100 rounded-lg text-green-600 mr-4 group-hover:bg-green-600 group-hover:text-white transition-colors">
                👤
            </span>
            <span class="font-bold text-slate-700">View Customers</span>
        <% end %>

        <%= link_to edit_user_registration_path, class: "flex items-center p-4 bg-white border border-slate-200 rounded-xl hover:bg-slate-50 transition-colors group" do %>
          <span class="p-3 bg-slate-100 rounded-lg text-slate-600 mr-4 group-hover:bg-slate-600 group-hover:text-white">⚙️</span>
          <span class="font-bold text-slate-700">Edit Profile</span>
        <% end %>

        <% if current_user.has_role?(:admin) %>
          <%= link_to admin_users_path, class: "flex items-center p-4 bg-white border border-slate-200 rounded-xl hover:bg-indigo-50 transition-colors group relative" do %>
            <div class="relative">
                <span class="p-3 bg-indigo-100 rounded-lg text-indigo-600 mr-4 group-hover:bg-indigo-600 group-hover:text-white transition-colors block">
                👥
                </span>
                <% if @staff_count > 0 %>
                <span class="absolute -top-2 -right-1 flex h-5 w-5 items-center justify-center rounded-full bg-indigo-600 text-[10px] font-bold text-white shadow-sm">
                    <%= @staff_count %>
                </span>
                <% end %>
            </div>
            
            <div class="flex flex-col">
                <span class="font-bold text-slate-700">Manage Staff</span>
                <span class="text-xs text-slate-500"><%= pluralize(@staff_count, 'team member') %> active</span>
            </div>
            <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>