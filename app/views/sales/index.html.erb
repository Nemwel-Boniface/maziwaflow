<div class="py-6 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  <div class="sm:flex sm:items-center sm:justify-between mb-8">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Sales History</h1>
    </div>
    <div class="mt-4 sm:mt-0">
      <%= link_to "New Sale", new_sale_path, class: "inline-flex items-center px-4 py-2 border border-transparent rounded-lg shadow-sm text-sm font-bold text-white bg-blue-600 hover:bg-blue-700" %>
    </div>
  </div>

  <div class="bg-white shadow border border-slate-200 rounded-2xl overflow-hidden">
    <table class="min-w-full divide-y divide-slate-200">
      <thead class="bg-slate-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Date</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Customer</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Liters</th>
          <th class="px-6 py-3 text-right text-xs font-semibold text-slate-500 uppercase">Total (KES)</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-slate-100">
        <% @sales.each do |sale| %>
          <tr class="hover:bg-slate-50">
            <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-500"><%= sale.created_at.strftime("%b %d, %H:%M") %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-slate-900"><%= sale.customer.name %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-600"><%= sale.liters %> L</td>
            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-bold text-slate-900">
              <%= number_to_currency(sale.total_amount, unit: "") %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>