<div class="max-w-2xl mx-auto py-8 px-4">
  <div class="mb-6">
    <%= link_to "← Back to Dashboard", dashboard_path, class: "text-sm font-medium text-blue-600 hover:text-blue-800" %>
  </div>

  <div class="bg-white shadow-sm border border-slate-200 rounded-2xl overflow-hidden">
    <div class="px-6 py-4 border-b border-slate-200 bg-blue-600">
      <h2 class="text-xl font-bold text-white">Record Milk Sale</h2>
    </div>

    <%# THE FIX: data: { turbo: false } ensures a standard HTML submission %>
    <%= form_with(model: @sale, data: { turbo: false }, class: "p-6 space-y-5") do |f| %>
      <% if @sale.errors.any? %>
        <div class="p-4 bg-red-50 border border-red-200 rounded-lg text-red-700 text-sm">
          <ul class="list-disc list-inside font-medium">
            <% @sale.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= f.label :customer_id, "Select Customer", class: "block text-sm font-semibold text-slate-700 mb-1" %>
        <%= f.collection_select :customer_id, Customer.active.ordered, :id, :name, 
            { prompt: "Choose a customer..." }, 
            { required: true, class: "block w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-blue-500 focus:border-blue-500 sm:text-sm shadow-sm" } %>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= f.label :liters, "Quantity (Liters)", class: "block text-sm font-semibold text-slate-700 mb-1" %>
          <%= f.number_field :liters, step: 0.01, placeholder: "0.0", required: true, class: "block w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-blue-500 focus:border-blue-500 sm:text-sm shadow-sm" %>
        </div>

        <div>
          <%= f.label :price_per_liter, "Price (per Liter)", class: "block text-sm font-semibold text-slate-700 mb-1" %>
          <%= f.number_field :price_per_liter, step: 0.01, required: true, class: "block w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-blue-500 focus:border-blue-500 sm:text-sm shadow-sm" %>
        </div>
      </div>

      <div>
        <%= f.label :notes, "Notes (Optional)", class: "block text-sm font-semibold text-slate-700 mb-1" %>
        <%= f.text_area :notes, rows: 2, placeholder: "e.g. Morning delivery", class: "block w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-blue-500 focus:border-blue-500 sm:text-sm shadow-sm" %>
      </div>

      <div class="pt-4">
        <%= f.submit "Complete Sale", class: "w-full flex justify-center py-3 px-4 border border-transparent rounded-lg shadow-sm text-sm font-bold text-white bg-blue-600 hover:bg-blue-700 cursor-pointer transition-all active:scale-95" %>
      </div>
    <% end %>
  </div>
</div>