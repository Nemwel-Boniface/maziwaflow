<div class="py-6 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <%= link_to "← Back to Custom SMS", custom_notifications_path, class: "text-sm font-medium text-slate-600 hover:text-blue-600" %>
      <h1 class="mt-2 text-2xl font-bold text-slate-900">Custom SMS Details</h1>
      <p class="mt-1 text-sm text-slate-600">Sent on <%= @custom_sms_campaign.created_at.strftime("%b %d, %Y %H:%M") %></p>
    </div>
    <div>
      <%= link_to "Reuse Message", new_custom_notification_path(reuse_from: @custom_sms_campaign.id), class: "inline-flex items-center px-4 py-2 border border-transparent rounded-lg shadow-sm text-sm font-bold text-white bg-emerald-600 hover:bg-emerald-700 transition-colors" %>
    </div>
  </div>

  <div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-6 mb-6">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm">
      <div>
        <p class="text-slate-500">Sender</p>
        <p class="font-semibold text-slate-800"><%= @custom_sms_campaign.sender&.name.presence || @custom_sms_campaign.sender&.email || "N/A" %></p>
      </div>
      <div>
        <p class="text-slate-500">Audience</p>
        <p class="font-semibold text-slate-800 capitalize"><%= @custom_sms_campaign.audience %></p>
      </div>
      <div>
        <p class="text-slate-500">Recipients</p>
        <p class="font-semibold text-slate-800"><%= @custom_sms_campaign.sms_notifications.count %></p>
      </div>
    </div>

    <div class="mt-5">
      <p class="text-slate-500 text-sm mb-1">Body</p>
      <div class="p-3 bg-slate-50 border border-slate-200 rounded-lg text-sm text-slate-800"><%= @custom_sms_campaign.body %></div>
    </div>
  </div>

  <div class="bg-white shadow border border-slate-200 rounded-2xl overflow-hidden">
    <div class="px-4 py-3 border-b border-slate-200 bg-slate-50">
      <h2 class="text-sm font-bold text-slate-800">Recipients and delivery status</h2>
    </div>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-200">
        <thead class="bg-slate-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Customer</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Phone</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Status</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Sent At</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Error</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-slate-100">
          <% @sms_notifications.each do |notification| %>
            <% customer = notification.notifiable %>
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-700"><%= customer.respond_to?(:name) ? customer.name : "N/A" %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-600"><%= notification.phone_number %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm">
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold <%= notification.status == 'sent' ? 'bg-emerald-50 text-emerald-700' : notification.status == 'failed' ? 'bg-red-50 text-red-700' : 'bg-slate-100 text-slate-700' %>">
                  <%= notification.status %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-600"><%= notification.sent_at&.strftime("%b %d, %Y %H:%M") || "-" %></td>
              <td class="px-6 py-4 text-sm text-red-600"><%= notification.error.presence || "-" %></td>
            </tr>
          <% end %>
          <% if @sms_notifications.none? %>
            <tr>
              <td colspan="5" class="px-6 py-10 text-center text-sm text-slate-500">No recipients found for this message.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
